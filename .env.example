# WildlifeGuard environment configuration
# Copy this file to .env and adjust values for your machine.

# --- Application ---
APP_NAME=WildlifeGuard
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite (local development). Switch to PostgreSQL in production, for example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/wildlifeguard
DATABASE_URL=sqlite:///./wildlifeguard.db

# --- Storage ---
VIDEO_STORAGE_DIR=./videos
PROCESSED_DIR=./processed
RESULTS_DIR=./results
MAX_VIDEO_SIZE_MB=250

# --- Video processing ---
PROCESS_FPS=5
FRAME_MAX_WIDTH=1280

# --- Models ---
# auto | cpu | cuda
MODEL_DEVICE=auto
DETECTION_MODEL_NAME=MDV6-yolov10-c
DETECTION_CONFIDENCE=0.35
CLASSIFICATION_MODEL_NAME=
CLASSIFICATION_CONFIDENCE=0.50
MODEL_WEIGHTS_DIR=./models

# --- Encounter-risk thresholds (prototype defaults; not safety claims) ---
RISK_LOW_MAX=25
RISK_MODERATE_MAX=50
RISK_HIGH_MAX=75
