APP_NAME=WildlifeGuard
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

